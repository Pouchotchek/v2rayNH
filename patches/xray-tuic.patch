+func TestReassembleSingleFragment(t *testing.T) {
+	c := &UDPConn{}
+	d := dest(t, "udp:1.1.1.1:53")
+
+	p, ok := c.reassemble(&packetHeader{PktID: 1, FragTotal: 1, Addr: &d}, []byte("hi"))
+	if !ok || string(p.data) != "hi" {
+		t.Fatalf("got %v %v", p, ok)
+	}
+	if _, ok := c.reassemble(&packetHeader{PktID: 2, FragTotal: 1}, []byte("hi")); ok {
+		t.Error("a packet without a source address must be dropped")
+	}
+}
