+func TestReassemble(t *testing.T) {
+	c := &UDPConn{}
+	d := dest(t, "udp:1.1.1.1:53")
+
+	// Out-of-order fragments; only the first one carries the address.
+	if _, ok := c.reassemble(&packetHeader{PktID: 1, FragTotal: 3, FragID: 2}, []byte("cc")); ok {
+		t.Fatal("complete too early")
+	}
+	if _, ok := c.reassemble(&packetHeader{PktID: 1, FragTotal: 3, FragID: 0, Addr: &d}, []byte("aa")); ok {
+		t.Fatal("complete too early")
+	}
+	p, ok := c.reassemble(&packetHeader{PktID: 1, FragTotal: 3, FragID: 1}, []byte("bb"))
+	if !ok {
+		t.Fatal("not complete")
+	}
+	if string(p.data) != "aabbcc" || p.addr.Port != 53 {
+		t.Errorf("got %q %v", p.data, p.addr)
+	}
+
+	// The slot is free again and a new packet id starts over.
+	if _, ok := c.reassemble(&packetHeader{PktID: 2, FragTotal: 2, FragID: 1}, []byte("y")); ok {
+		t.Fatal("complete too early")
+	}
+	if _, ok := c.reassemble(&packetHeader{PktID: 3, FragTotal: 2, FragID: 0, Addr: &d}, []byte("x")); ok {
+		t.Fatal("a fragment of another packet must not complete this one")
+	}
+}
