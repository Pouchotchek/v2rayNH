diff --git a/infra/conf/tuic.go b/infra/conf/tuic.go
new file mode 100644
index 0000000..4326b35
--- /dev/null
+++ b/infra/conf/tuic.go
@@ -0,0 +1,76 @@
+package conf
+
+import (
+	"strings"
+
+	"github.com/google/uuid"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/proxy/tuic"
+	transport "github.com/xtls/xray-core/transport/internet/tuic"
+	"google.golang.org/protobuf/proto"
+)
+
+// TuicClientConfig is the "tuic" outbound; credentials live in streamSettings.tuicSettings.
+type TuicClientConfig struct {
+	Version int32    `json:"version"`
+	Address *Address `json:"address"`
+	Port    uint16   `json:"port"`
+}
+
+func (c *TuicClientConfig) Build() (proto.Message, error) {
+	if c.Version != 0 && c.Version != 5 {
+		return nil, errors.New("tuic: only version 5 is supported")
+	}
+	if c.Address == nil {
+		return nil, errors.New("tuic: server address is not set")
+	}
+
+	config := &tuic.ClientConfig{}
+	config.Server = &protocol.ServerEndpoint{
+		Address: c.Address.Build(),
+		Port:    uint32(c.Port),
+	}
+
+	return config, nil
+}
+
+// TuicConfig is streamSettings.tuicSettings.
+type TuicConfig struct {
+	UUID              string `json:"uuid"`
+	Password          string `json:"password"`
+	CongestionControl string `json:"congestionControl"`
+	UdpRelayMode      string `json:"udpRelayMode"`
+	ZeroRtt           bool   `json:"zeroRtt"`
+}
+
+func (c *TuicConfig) Build() (proto.Message, error) {
+	id, err := uuid.Parse(strings.TrimSpace(c.UUID))
+	if err != nil {
+		return nil, errors.New("tuic: invalid uuid").Base(err)
+	}
+
+	congestion := strings.ToLower(c.CongestionControl)
+	switch congestion {
+	case "", transport.CongestionCubic, transport.CongestionNewReno, transport.CongestionBBR:
+	case "reno":
+		congestion = transport.CongestionNewReno
+	default:
+		return nil, errors.New(`tuic: congestionControl must be "cubic", "new_reno" or "bbr", not "`, c.CongestionControl, `"`)
+	}
+
+	relay := strings.ToLower(c.UdpRelayMode)
+	switch relay {
+	case "", transport.UDPRelayNative, transport.UDPRelayQUIC:
+	default:
+		return nil, errors.New(`tuic: udpRelayMode must be "native" or "quic", not "`, c.UdpRelayMode, `"`)
+	}
+
+	return &transport.Config{
+		Uuid:              id.String(),
+		Password:          c.Password,
+		CongestionControl: congestion,
+		UdpRelayMode:      relay,
+		ZeroRtt:           c.ZeroRtt,
+	}, nil
+}
diff --git a/infra/conf/tuic_test.go b/infra/conf/tuic_test.go
new file mode 100644
index 0000000..a00c83b
--- /dev/null
+++ b/infra/conf/tuic_test.go
@@ -0,0 +1,107 @@
+package conf_test
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/xtls/xray-core/app/proxyman"
+	. "github.com/xtls/xray-core/infra/conf"
+	"github.com/xtls/xray-core/transport/internet/tuic"
+)
+
+// Same shape that the v2rayNG app generates for a TUIC profile.
+const tuicOutbound = `{
+	"tag": "proxy",
+	"protocol": "tuic",
+	"settings": {"address": "example.com", "port": 443, "version": 5},
+	"streamSettings": {
+		"network": "tuic",
+		"security": "tls",
+		"tlsSettings": {"serverName": "example.com", "alpn": ["h3"]},
+		"tuicSettings": {
+			"uuid": "b3a1c2d4-1111-2222-3333-444455556666",
+			"password": "secret",
+			"congestionControl": "bbr",
+			"udpRelayMode": "quic",
+			"zeroRtt": true
+		}
+	}
+}`
+
+func TestTuicOutbound(t *testing.T) {
+	c := new(OutboundDetourConfig)
+	if err := json.Unmarshal([]byte(tuicOutbound), c); err != nil {
+		t.Fatal(err)
+	}
+	built, err := c.Build()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if built.ProxySettings == nil {
+		t.Fatal("no proxy settings")
+	}
+
+	senderMsg, err := built.SenderSettings.GetInstance()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ss := senderMsg.(*proxyman.SenderConfig).StreamSettings
+	if ss.ProtocolName != "tuic" {
+		t.Fatalf("transport is %q", ss.ProtocolName)
+	}
+
+	var cfg *tuic.Config
+	for _, ts := range ss.TransportSettings {
+		if ts.ProtocolName != "tuic" {
+			continue
+		}
+		inst, err := ts.Settings.GetInstance()
+		if err != nil {
+			t.Fatal(err)
+		}
+		cfg = inst.(*tuic.Config)
+	}
+	if cfg == nil {
+		t.Fatal("no tuic transport settings")
+	}
+	if cfg.Uuid != "b3a1c2d4-1111-2222-3333-444455556666" || cfg.Password != "secret" ||
+		cfg.CongestionControl != "bbr" || cfg.UdpRelayMode != "quic" || !cfg.ZeroRtt {
+		t.Errorf("unexpected config %+v", cfg)
+	}
+}
+
+func TestTuicConfigValidation(t *testing.T) {
+	cases := map[string]string{
+		"bad uuid":       `"uuid": "not-a-uuid"`,
+		"bad congestion": `"uuid": "b3a1c2d4-1111-2222-3333-444455556666", "congestionControl": "vegas"`,
+		"bad relay mode": `"uuid": "b3a1c2d4-1111-2222-3333-444455556666", "udpRelayMode": "tcp"`,
+	}
+	for name, fields := range cases {
+		var c TuicConfig
+		if err := json.Unmarshal([]byte("{"+fields+"}"), &c); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := c.Build(); err == nil {
+			t.Errorf("%s: expected an error", name)
+		}
+	}
+
+	// Defaults are accepted and the old "reno" spelling maps to new_reno.
+	for _, in := range []string{`{"uuid":"b3a1c2d4-1111-2222-3333-444455556666"}`, `{"uuid":"b3a1c2d4-1111-2222-3333-444455556666","congestionControl":"reno"}`} {
+		var c TuicConfig
+		if err := json.Unmarshal([]byte(in), &c); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := c.Build(); err != nil {
+			t.Errorf("%s: %v", in, err)
+		}
+	}
+}
+
+func TestTuicClientVersion(t *testing.T) {
+	c := &TuicClientConfig{Version: 4}
+	if _, err := c.Build(); err == nil || !strings.Contains(err.Error(), "version 5") {
+		t.Errorf("expected a version error, got %v", err)
+	}
+}
