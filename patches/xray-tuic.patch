@@ -0,0 +1,420 @@
+package tuic
+
+import (
+	"bytes"
+	"context"
+	go_errors "errors"
+	"io"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/apernet/quic-go"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+)
+
+// tcpConn is the bidirectional QUIC stream of one TUIC Connect. The Connect header itself
+// (see AppendConnectHeader) is written by the proxy layer as the first bytes of the stream.
+type tcpConn struct {
+	stream *quic.Stream
+	local  net.Addr
+	remote net.Addr
+	wrote  atomic.Bool
+}
+
+func (c *tcpConn) Read(b []byte) (int, error) {
+	return c.stream.Read(b)
+}
+
+func (c *tcpConn) Write(b []byte) (int, error) {
+	c.wrote.Store(true)
+	return c.stream.Write(b)
+}
+
+func (c *tcpConn) Close() error {
+	c.stream.CancelRead(0)
+	if !c.wrote.Load() {
+		// Nothing was sent: do not leave an empty stream for the server to interpret.
+		c.stream.CancelWrite(0)
+		return nil
+	}
+	return c.stream.Close()
+}
+
+func (c *tcpConn) LocalAddr() net.Addr                { return c.local }
+func (c *tcpConn) RemoteAddr() net.Addr               { return c.remote }
+func (c *tcpConn) SetDeadline(t time.Time) error      { return c.stream.SetDeadline(t) }
+func (c *tcpConn) SetReadDeadline(t time.Time) error  { return c.stream.SetReadDeadline(t) }
+func (c *tcpConn) SetWriteDeadline(t time.Time) error { return c.stream.SetWriteDeadline(t) }
+
+type udpPacket struct {
+	addr net.Destination
+	data []byte
+}
+
+// fragSlot reassembles the fragments of one in-flight packet of an association.
+type fragSlot struct {
+	active bool
+	pktID  uint16
+	total  uint8
+	got    uint8
+	addr   *net.Destination
+	parts  [][]byte
+}
+
+// UDPConn is one TUIC UDP association (ASSOC_ID). Use WritePacket and ReadPacket; the net.Conn
+// methods exist only so the dialer can return it as a connection.
+type UDPConn struct {
+	m      *udpSessionManager
+	id     uint16
+	ch     chan udpPacket
+	closed bool // guarded by m
+
+	pktID atomic.Uint32
+
+	fragMu sync.Mutex
+	frag   fragSlot
+}
+
+func (c *UDPConn) nextPktID() uint16 {
+	return uint16(c.pktID.Add(1))
+}
+
+// WritePacket sends one UDP payload to dest through the server.
+func (c *UDPConn) WritePacket(dest net.Destination, data []byte) error {
+	if len(data) > 0xffff {
+		return errors.New("tuic: UDP payload too large")
+	}
+	return c.m.send(c, dest, data)
+}
+
+// ReadPacket blocks until a packet arrives from the server. It returns io.EOF after Close.
+func (c *UDPConn) ReadPacket() (net.Destination, []byte, error) {
+	p, ok := <-c.ch
+	if !ok {
+		return net.Destination{}, nil, io.EOF
+	}
+	return p.addr, p.data, nil
+}
+
+// reassemble joins fragments. It returns ok=false until a full packet with a known source is available.
+func (c *UDPConn) reassemble(h *packetHeader, data []byte) (udpPacket, bool) {
+	if h.FragTotal <= 1 {
+		if h.Addr == nil {
+			return udpPacket{}, false
+		}
+		return udpPacket{addr: *h.Addr, data: data}, true
+	}
+
+	c.fragMu.Lock()
+	defer c.fragMu.Unlock()
+
+	f := &c.frag
+	if !f.active || f.pktID != h.PktID || f.total != h.FragTotal {
+		*f = fragSlot{active: true, pktID: h.PktID, total: h.FragTotal, parts: make([][]byte, h.FragTotal)}
+	}
+	if h.FragID >= f.total {
+		return udpPacket{}, false
+	}
+	if f.parts[h.FragID] == nil {
+		part := make([]byte, len(data))
+		copy(part, data)
+		f.parts[h.FragID] = part
+		f.got++
+	}
+	if h.Addr != nil {
+		f.addr = h.Addr
+	}
+	if f.got < f.total || f.addr == nil {
+		return udpPacket{}, false
+	}
+
+	var out []byte
+	for _, p := range f.parts {
+		out = append(out, p...)
+	}
+	addr := *f.addr
+	*f = fragSlot{}
+	return udpPacket{addr: addr, data: out}, true
+}
+
+func (c *UDPConn) Close() error {
+	c.m.closeConn(c, true)
+	return nil
+}
+
+func (c *UDPConn) Read(b []byte) (int, error) {
+	_, data, err := c.ReadPacket()
+	if err != nil {
+		return 0, err
+	}
+	return copy(b, data), nil
+}
+
+func (c *UDPConn) Write(b []byte) (int, error) {
+	return 0, errors.New("tuic: use WritePacket on a UDP association")
+}
+
+func (c *UDPConn) LocalAddr() net.Addr                { return c.m.conn.LocalAddr() }
+func (c *UDPConn) RemoteAddr() net.Addr               { return c.m.conn.RemoteAddr() }
+func (c *UDPConn) SetDeadline(t time.Time) error      { return nil }
+func (c *UDPConn) SetReadDeadline(t time.Time) error  { return nil }
+func (c *UDPConn) SetWriteDeadline(t time.Time) error { return nil }
+
+// udpSessionManager owns all UDP associations of one QUIC connection.
+type udpSessionManager struct {
+	sync.RWMutex
+
+	conn     *quic.Conn
+	m        map[uint16]*UDPConn
+	next     uint16
+	closed   bool
+	quicMode bool // UDP relay mode "quic": one unidirectional stream per packet instead of datagrams
+}
+
+func newUDPSessionManager(conn *quic.Conn, quicMode bool) *udpSessionManager {
+	return &udpSessionManager{
+		conn:     conn,
+		m:        make(map[uint16]*UDPConn),
+		next:     1,
+		quicMode: quicMode,
+	}
+}
+
+func (m *udpSessionManager) newConn() (*UDPConn, error) {
+	m.Lock()
+	defer m.Unlock()
+
+	if m.closed {
+		return nil, errors.New("tuic: connection closed")
+	}
+	for i := 0; i <= 0xffff; i++ {
+		id := m.next
+		m.next++
+		if _, used := m.m[id]; used {
+			continue
+		}
+		c := &UDPConn{m: m, id: id, ch: make(chan udpPacket, udpMessageChanSize)}
+		m.m[id] = c
+		return c, nil
+	}
+	return nil, errors.New("tuic: no free UDP association id")
+}
+
+func (m *udpSessionManager) closeConn(c *UDPConn, dissociate bool) {
+	m.Lock()
+	if c.closed {
+		m.Unlock()
+		return
+	}
+	c.closed = true
+	close(c.ch)
+	delete(m.m, c.id)
+	connClosed := m.closed
+	m.Unlock()
+
+	if dissociate && !connClosed {
+		go m.dissociate(c.id)
+	}
+}
+
+// shutdown closes every association; called when the QUIC connection is gone.
+func (m *udpSessionManager) shutdown() {
+	m.Lock()
+	defer m.Unlock()
+
+	m.closed = true
+	for id, c := range m.m {
+		if !c.closed {
+			c.closed = true
+			close(c.ch)
+		}
+		delete(m.m, id)
+	}
+}
+
+func (m *udpSessionManager) dissociate(id uint16) {
+	ctx, cancel := context.WithTimeout(context.Background(), openStreamTimeout)
+	defer cancel()
+	s, err := m.conn.OpenUniStreamSync(ctx)
+	if err != nil {
+		return
+	}
+	if _, err := s.Write(AppendDissociate(nil, id)); err != nil {
+		s.CancelWrite(0)
+		return
+	}
+	_ = s.Close()
+}
+
+// runDatagrams feeds datagram Packets (native mode responses) into their associations.
+func (m *udpSessionManager) runDatagrams() {
+	for {
+		d, err := m.conn.ReceiveDatagram(context.Background())
+		if err != nil {
+			break
+		}
+		m.handleDatagram(d)
+	}
+	m.shutdown()
+}
+
+// uniReceiver is the part of a QUIC receive stream used here.
+type uniReceiver interface {
+	io.Reader
+	CancelRead(quic.StreamErrorCode)
+}
+
+// runUniStreams feeds Packets that the server sends on unidirectional streams (quic mode responses).
+func (m *udpSessionManager) runUniStreams() {
+	for {
+		s, err := m.conn.AcceptUniStream(context.Background())
+		if err != nil {
+			return
+		}
+		go m.handleUniStream(s)
+	}
+}
+
+func (m *udpSessionManager) handleDatagram(d []byte) {
+	r := bytes.NewReader(d)
+	cmd, err := readCommandHeader(r)
+	if err != nil || cmd != CmdPacket {
+		// Heartbeats and anything else carry nothing for us.
+		return
+	}
+	h, err := readPacketHeader(r)
+	if err != nil {
+		return
+	}
+	data := d[len(d)-r.Len():]
+	if len(data) < int(h.Size) {
+		return
+	}
+	m.feed(h, data[:h.Size])
+}
+
+func (m *udpSessionManager) handleUniStream(s uniReceiver) {
+	defer s.CancelRead(0)
+
+	cmd, err := readCommandHeader(s)
+	if err != nil || cmd != CmdPacket {
+		return
+	}
+	h, err := readPacketHeader(s)
+	if err != nil {
+		return
+	}
+	data := make([]byte, h.Size)
+	if _, err := io.ReadFull(s, data); err != nil {
+		return
+	}
+	m.feed(h, data)
+}
+
+func (m *udpSessionManager) feed(h *packetHeader, data []byte) {
+	m.RLock()
+	defer m.RUnlock()
+
+	c, ok := m.m[h.AssocID]
+	if !ok || c.closed {
+		return
+	}
+	p, ok := c.reassemble(h, data)
+	if !ok {
+		return
+	}
+	select {
+	case c.ch <- p:
+	default:
+	}
+}
+
+func (m *udpSessionManager) send(c *UDPConn, dest net.Destination, data []byte) error {
+	m.RLock()
+	closed := m.closed || c.closed
+	m.RUnlock()
+	if closed {
+		return io.ErrClosedPipe
+	}
+
+	h := packetHeader{
+		AssocID:   c.id,
+		PktID:     c.nextPktID(),
+		FragTotal: 1,
+		FragID:    0,
+		Size:      uint16(len(data)),
+		Addr:      &dest,
+	}
+	msg, err := h.append(make([]byte, 0, 64+len(data)))
+	if err != nil {
+		return err
+	}
+	msg = append(msg, data...)
+
+	if m.quicMode {
+		return m.sendOnStream(msg)
+	}
+
+	err = m.conn.SendDatagram(msg)
+	var tooLarge *quic.DatagramTooLargeError
+	if go_errors.As(err, &tooLarge) {
+		return m.sendFragments(&h, dest, data, int(tooLarge.MaxDatagramPayloadSize))
+	}
+	return err
+}
+
+func (m *udpSessionManager) sendOnStream(msg []byte) error {
+	ctx, cancel := context.WithTimeout(context.Background(), openStreamTimeout)
+	defer cancel()
+	s, err := m.conn.OpenUniStreamSync(ctx)
+	if err != nil {
+		return err
+	}
+	if _, err := s.Write(msg); err != nil {
+		s.CancelWrite(0)
+		return err
+	}
+	return s.Close()
+}
+
+// sendFragments splits a payload that does not fit into one datagram.
+func (m *udpSessionManager) sendFragments(first *packetHeader, dest net.Destination, data []byte, maxPayload int) error {
+	addr, err := AppendAddress(nil, dest)
+	if err != nil {
+		return err
+	}
+	chunk := maxPayload - (packetHeaderLength + len(addr))
+	if chunk <= 0 {
+		return errors.New("tuic: datagram size too small for UDP relay")
+	}
+	total := (len(data) + chunk - 1) / chunk
+	if total > 0xff {
+		return errors.New("tuic: UDP payload needs too many fragments")
+	}
+
+	for i := 0; i < total; i++ {
+		end := min((i+1)*chunk, len(data))
+		part := data[i*chunk : end]
+		h := packetHeader{
+			AssocID:   first.AssocID,
+			PktID:     first.PktID,
+			FragTotal: uint8(total),
+			FragID:    uint8(i),
+			Size:      uint16(len(part)),
+		}
+		if i == 0 {
+			h.Addr = &dest
+		}
+		msg, err := h.append(make([]byte, 0, packetHeaderLength+len(addr)+len(part)))
+		if err != nil {
+			return err
+		}
+		msg = append(msg, part...)
+		if err := m.conn.SendDatagram(msg); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/transport/internet/tuic/dialer.go b/transport/internet/tuic/dialer.go
new file mode 100644
index 0000000..8c1688f
--- /dev/null
+++ b/transport/internet/tuic/dialer.go
@@ -0,0 +1,364 @@
+package tuic
+
+import (
+	"context"
+	gotls "crypto/tls"
+	"reflect"
+	"runtime"
+	"sync"
+	"time"
+
+	"github.com/apernet/quic-go"
+	"github.com/google/uuid"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/net/cnc"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/finalmask"
+	"github.com/xtls/xray-core/transport/internet/hysteria/congestion"
+	"github.com/xtls/xray-core/transport/internet/hysteria/congestion/bbr"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/internet/tls"
+)
+
+type client struct {
+	lock         chan struct{}
+	instance     *core.Instance
+	forced       bool
+	dest         net.Destination
+	config       *Config
+	uuid         [16]byte
+	tlsConfig    *gotls.Config
+	socketConfig *internet.SocketConfig
+	finalMask    *finalmask.FinalMask
+	quicParams   *internet.QuicParams
+
+	conn    *quic.Conn
+	tr      *quic.Transport
+	pktConn net.PacketConn
+	udpSM   *udpSessionManager
+}
+
+func (c *client) status() status {
+	if c.conn == nil {
+		return StatusNull
+	}
+	select {
+	case <-c.conn.Context().Done():
+		return StatusInactive
+	default:
+		return StatusActive
+	}
+}
+
+func (c *client) close() {
+	c.conn.CloseWithError(closeErrCodeOK, "")
+	c.tr.Close()
+	c.pktConn.Close()
+	c.conn = nil
+	c.tr = nil
+	c.pktConn = nil
+	c.udpSM = nil
+}
+
+func (c *client) abort(tr *quic.Transport, pktConn net.PacketConn, conn *quic.Conn) {
+	if conn != nil {
+		_ = conn.CloseWithError(closeErrCodeOK, "")
+	}
+	_ = tr.Close()
+	_ = pktConn.Close()
+}
+
+func (c *client) dial(ctx context.Context) error {
+	if c.forced {
+		return errors.New("client is closed")
+	}
+
+	switch c.status() {
+	case StatusActive:
+		return nil
+	case StatusInactive:
+		c.close()
+	}
+
+	quicParams := c.quicParams
+	if quicParams == nil {
+		quicParams = &internet.QuicParams{
+			BbrProfile: string(bbr.ProfileStandard),
+		}
+	}
+
+	quicConfig := &quic.Config{
+		InitialStreamReceiveWindow:     quicParams.InitStreamReceiveWindow,
+		MaxStreamReceiveWindow:         quicParams.MaxStreamReceiveWindow,
+		InitialConnectionReceiveWindow: quicParams.InitConnReceiveWindow,
+		MaxConnectionReceiveWindow:     quicParams.MaxConnReceiveWindow,
+		MaxIdleTimeout:                 time.Duration(quicParams.MaxIdleTimeout) * time.Second,
+		KeepAlivePeriod:                time.Duration(quicParams.KeepAlivePeriod) * time.Second,
+		DisablePathMTUDiscovery:        quicParams.DisablePathMtuDiscovery || (runtime.GOOS != "linux" && runtime.GOOS != "windows" && runtime.GOOS != "darwin"),
+		// The server needs our max_datagram_frame_size to answer in native UDP relay mode,
+		// so unlike Hysteria this transport does not omit it.
+		EnableDatagrams:    true,
+		DisablePathManager: true,
+	}
+	if quicParams.InitStreamReceiveWindow == 0 {
+		quicConfig.InitialStreamReceiveWindow = 8388608
+	}
+	if quicParams.MaxStreamReceiveWindow == 0 {
+		quicConfig.MaxStreamReceiveWindow = 8388608
+	}
+	if quicParams.InitConnReceiveWindow == 0 {
+		quicConfig.InitialConnectionReceiveWindow = 8388608 * 5 / 2
+	}
+	if quicParams.MaxConnReceiveWindow == 0 {
+		quicConfig.MaxConnectionReceiveWindow = 8388608 * 5 / 2
+	}
+	if quicParams.MaxIdleTimeout == 0 {
+		quicConfig.MaxIdleTimeout = maxIdleTimeout
+	}
+	if quicParams.KeepAlivePeriod == 0 {
+		quicConfig.KeepAlivePeriod = keepAlivePeriod
+	}
+
+	var pktConn net.PacketConn
+	var udpAddr net.Addr
+	if c.finalMask != nil {
+		conn, err := c.finalMask.DialUDP(ctx, c.dest)
+		if err != nil {
+			return errors.New("failed to dial to dest").Base(err)
+		}
+		pktConn = conn.(*net.PacketConnWrapper).PacketConn
+		udpAddr = conn.RemoteAddr()
+	} else {
+		conn, err := internet.DialSystem(ctx, c.dest, c.socketConfig)
+		if err != nil {
+			return errors.New("failed to dial to dest").Base(err)
+		}
+		switch c := conn.(type) {
+		case *net.PacketConnWrapper:
+			pktConn = c.PacketConn
+			udpAddr = c.RemoteAddr()
+		case *cnc.Connection:
+			pktConn = &internet.FakePacketConn{Conn: c}
+			udpAddr = &net.UDPAddr{IP: []byte{0, 0, 0, 0}}
+		default:
+			panic(reflect.TypeOf(c))
+		}
+	}
+
+	tr := &quic.Transport{Conn: pktConn, DisableGSO: quicParams.DisableGSO}
+
+	var conn *quic.Conn
+	var err error
+	if c.config.ZeroRtt {
+		conn, err = tr.DialEarly(ctx, udpAddr, c.tlsConfig, quicConfig)
+	} else {
+		conn, err = tr.Dial(ctx, udpAddr, c.tlsConfig, quicConfig)
+	}
+	if err != nil {
+		c.abort(tr, pktConn, nil)
+		return errors.New("failed to establish QUIC connection").Base(err)
+	}
+
+	// The authentication token is derived from the TLS session, so the handshake must be complete.
+	select {
+	case <-conn.HandshakeComplete():
+	case <-ctx.Done():
+		c.abort(tr, pktConn, conn)
+		return ctx.Err()
+	}
+
+	if err := c.authenticate(ctx, conn); err != nil {
+		c.abort(tr, pktConn, conn)
+		return err
+	}
+
+	if c.config.CongestionControl == CongestionBBR {
+		congestion.UseBBR(conn, bbr.Profile(quicParams.BbrProfile))
+	}
+	// "cubic" (default) and "new_reno" keep the QUIC stack's own loss-based controller.
+
+	c.pktConn = pktConn
+	c.tr = tr
+	c.conn = conn
+	c.udpSM = newUDPSessionManager(conn, c.config.UdpRelayMode == UDPRelayQUIC)
+	go c.udpSM.runDatagrams()
+	go c.udpSM.runUniStreams()
+
+	return nil
+}
+
+// authenticate sends the Authenticate command on a unidirectional stream.
+func (c *client) authenticate(ctx context.Context, conn *quic.Conn) error {
+	state := conn.ConnectionState()
+	token, err := state.TLS.ExportKeyingMaterial(string(c.uuid[:]), []byte(c.config.Password), tokenLength)
+	if err != nil {
+		return errors.New("failed to derive TUIC token").Base(err)
+	}
+
+	openCtx, cancel := context.WithTimeout(ctx, openStreamTimeout)
+	defer cancel()
+	s, err := conn.OpenUniStreamSync(openCtx)
+	if err != nil {
+		return errors.New("failed to open authentication stream").Base(err)
+	}
+	if _, err := s.Write(AppendAuthenticate(nil, c.uuid, token)); err != nil {
+		s.CancelWrite(0)
+		return errors.New("failed to send authentication").Base(err)
+	}
+	return s.Close()
+}
+
+func (c *client) unlock() {
+	<-c.lock
+}
+
+func (c *client) tcp(ctx context.Context) (stat.Connection, error) {
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case c.lock <- struct{}{}:
+		defer c.unlock()
+	}
+
+	err := c.dial(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	stream, err := c.conn.OpenStreamSync(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	return &tcpConn{
+		stream: stream,
+		local:  c.conn.LocalAddr(),
+		remote: c.conn.RemoteAddr(),
+	}, nil
+}
+
+func (c *client) udp(ctx context.Context) (stat.Connection, error) {
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case c.lock <- struct{}{}:
+		defer c.unlock()
+	}
+
+	err := c.dial(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	return c.udpSM.newConn()
+}
+
+func (c *client) clean(force bool) {
+	c.lock <- struct{}{}
+	if force {
+		c.forced = true
+	}
+	if status := c.status(); force && status != StatusNull || status == StatusInactive {
+		c.close()
+	}
+	c.unlock()
+}
+
+type dialerConf struct {
+	net.Destination
+	*internet.MemoryStreamConfig
+}
+
+type clientManager struct {
+	sync.RWMutex
+	m map[dialerConf]*client
+}
+
+func (m *clientManager) clean() {
+	ticker := time.NewTicker(idleCleanupInterval)
+	for range ticker.C {
+		m.RLock()
+		entries := make(map[dialerConf]*client, len(m.m))
+		for k, c := range m.m {
+			entries[k] = c
+		}
+		m.RUnlock()
+		for k, c := range entries {
+			force := c.instance != nil && !c.instance.IsRunning()
+			c.clean(force)
+			if force {
+				m.Lock()
+				delete(m.m, k)
+				m.Unlock()
+			}
+		}
+	}
+}
+
+var (
+	manager     *clientManager
+	initmanager sync.Once
+)
+
+func Dial(ctx context.Context, dest net.Destination, streamSettings *internet.MemoryStreamConfig) (stat.Connection, error) {
+	tlsConfig := tls.ConfigFromStreamSettings(streamSettings)
+	if tlsConfig == nil {
+		return nil, errors.New("tls config is nil")
+	}
+	config, ok := streamSettings.ProtocolSettings.(*Config)
+	if !ok {
+		return nil, errors.New("not tuic transport")
+	}
+	id, err := uuid.Parse(config.Uuid)
+	if err != nil {
+		return nil, errors.New("invalid TUIC uuid").Base(err)
+	}
+
+	datagram := DatagramFromContext(ctx)
+	dest.Network = net.Network_UDP
+
+	initmanager.Do(func() {
+		manager = &clientManager{
+			m: make(map[dialerConf]*client),
+		}
+		go manager.clean()
+	})
+
+	dialerConfKey := dialerConf{dest, streamSettings}
+
+	manager.RLock()
+	c := manager.m[dialerConfKey]
+	manager.RUnlock()
+
+	if c == nil {
+		manager.Lock()
+		c = manager.m[dialerConfKey]
+		if c == nil {
+			c = &client{
+				lock:         make(chan struct{}, 1),
+				instance:     core.FromContext(ctx),
+				dest:         dest,
+				config:       config,
+				uuid:         id,
+				tlsConfig:    tlsConfig.GetTLSConfig(tls.WithDestination(dest)),
+				socketConfig: streamSettings.SocketSettings,
+				finalMask:    streamSettings.FinalMask,
+				quicParams:   streamSettings.QuicParams,
+			}
+			manager.m[dialerConfKey] = c
+		}
+		manager.Unlock()
+	}
+
+	if datagram {
+		return c.udp(ctx)
+	}
+	return c.tcp(ctx)
+}
+
+func init() {
+	common.Must(internet.RegisterTransportDialer(protocolName, Dial))
+}
diff --git a/transport/internet/tuic/protocol.go b/transport/internet/tuic/protocol.go
new file mode 100644
index 0000000..5036e18
--- /dev/null
+++ b/transport/internet/tuic/protocol.go
@@ -0,0 +1,167 @@
+package tuic
+
+import (
+	"encoding/binary"
+	"io"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+)
+
+// AppendAddress appends ADDR (TYPE, address, PORT) to b.
+func AppendAddress(b []byte, dest net.Destination) ([]byte, error) {
+	addr := dest.Address
+	if addr == nil {
+		return nil, errors.New("tuic: empty address")
+	}
+	switch family := addr.Family(); {
+	case family.IsIPv4():
+		ip := addr.IP().To4()
+		if ip == nil {
+			return nil, errors.New("tuic: invalid IPv4 address")
+		}
+		b = append(b, AddrTypeIPv4)
+		b = append(b, ip...)
+	case family.IsIPv6():
+		ip := addr.IP().To16()
+		if ip == nil {
+			return nil, errors.New("tuic: invalid IPv6 address")
+		}
+		b = append(b, AddrTypeIPv6)
+		b = append(b, ip...)
+	case family.IsDomain():
+		domain := addr.Domain()
+		if len(domain) == 0 || len(domain) > 255 {
+			return nil, errors.New("tuic: invalid domain length ", len(domain))
+		}
+		b = append(b, AddrTypeDomain, byte(len(domain)))
+		b = append(b, domain...)
+	default:
+		return nil, errors.New("tuic: unsupported address family")
+	}
+	return binary.BigEndian.AppendUint16(b, dest.Port.Value()), nil
+}
+
+// ReadAddress parses ADDR from r. It returns a nil destination for the "none" address type,
+// which is only used by non-first fragments of a Packet.
+func ReadAddress(r io.Reader) (*net.Destination, error) {
+	var t [1]byte
+	if _, err := io.ReadFull(r, t[:]); err != nil {
+		return nil, err
+	}
+
+	var addr net.Address
+	switch t[0] {
+	case AddrTypeNone:
+		return nil, nil
+	case AddrTypeIPv4:
+		var ip [4]byte
+		if _, err := io.ReadFull(r, ip[:]); err != nil {
+			return nil, err
+		}
+		addr = net.IPAddress(ip[:])
+	case AddrTypeIPv6:
+		var ip [16]byte
+		if _, err := io.ReadFull(r, ip[:]); err != nil {
+			return nil, err
+		}
+		addr = net.IPAddress(ip[:])
+	case AddrTypeDomain:
+		var l [1]byte
+		if _, err := io.ReadFull(r, l[:]); err != nil {
+			return nil, err
+		}
+		domain := make([]byte, l[0])
+		if _, err := io.ReadFull(r, domain); err != nil {
+			return nil, err
+		}
+		addr = net.DomainAddress(string(domain))
+	default:
+		return nil, errors.New("tuic: unknown address type ", t[0])
+	}
+	if addr == nil {
+		return nil, errors.New("tuic: invalid address")
+	}
+
+	var p [2]byte
+	if _, err := io.ReadFull(r, p[:]); err != nil {
+		return nil, err
+	}
+	dest := net.UDPDestination(addr, net.Port(binary.BigEndian.Uint16(p[:])))
+	return &dest, nil
+}
+
+// AppendConnectHeader appends the Connect command (VER, TYPE, ADDR) that opens a TCP relay stream.
+func AppendConnectHeader(b []byte, target net.Destination) ([]byte, error) {
+	b = append(b, Version, CmdConnect)
+	return AppendAddress(b, target)
+}
+
+// AppendAuthenticate appends the Authenticate command.
+func AppendAuthenticate(b []byte, uuid [16]byte, token []byte) []byte {
+	b = append(b, Version, CmdAuthenticate)
+	b = append(b, uuid[:]...)
+	return append(b, token...)
+}
+
+// AppendDissociate appends the Dissociate command that ends a UDP association.
+func AppendDissociate(b []byte, assocID uint16) []byte {
+	b = append(b, Version, CmdDissociate)
+	return binary.BigEndian.AppendUint16(b, assocID)
+}
+
+// packetHeader is the Packet command (without VER and TYPE handling on the read side).
+type packetHeader struct {
+	AssocID   uint16
+	PktID     uint16
+	FragTotal uint8
+	FragID    uint8
+	Size      uint16
+	// Addr is nil when the address type is "none".
+	Addr *net.Destination
+}
+
+func (h *packetHeader) append(b []byte) ([]byte, error) {
+	b = append(b, Version, CmdPacket)
+	b = binary.BigEndian.AppendUint16(b, h.AssocID)
+	b = binary.BigEndian.AppendUint16(b, h.PktID)
+	b = append(b, h.FragTotal, h.FragID)
+	b = binary.BigEndian.AppendUint16(b, h.Size)
+	if h.Addr == nil {
+		return append(b, AddrTypeNone), nil
+	}
+	return AppendAddress(b, *h.Addr)
+}
+
+// readCommandHeader reads VER and TYPE.
+func readCommandHeader(r io.Reader) (byte, error) {
+	var h [2]byte
+	if _, err := io.ReadFull(r, h[:]); err != nil {
+		return 0, err
+	}
+	if h[0] != Version {
+		return 0, errors.New("tuic: unsupported version ", h[0])
+	}
+	return h[1], nil
+}
+
+// readPacketHeader reads the fields of a Packet command that follow VER and TYPE.
+func readPacketHeader(r io.Reader) (*packetHeader, error) {
+	var f [8]byte
+	if _, err := io.ReadFull(r, f[:]); err != nil {
+		return nil, err
+	}
+	h := &packetHeader{
+		AssocID:   binary.BigEndian.Uint16(f[0:2]),
+		PktID:     binary.BigEndian.Uint16(f[2:4]),
+		FragTotal: f[4],
+		FragID:    f[5],
+		Size:      binary.BigEndian.Uint16(f[6:8]),
+	}
+	addr, err := ReadAddress(r)
+	if err != nil {
+		return nil, err
+	}
+	h.Addr = addr
+	return h, nil
+}
diff --git a/transport/internet/tuic/protocol_test.go b/transport/internet/tuic/protocol_test.go
new file mode 100644
index 0000000..3fd90a4
--- /dev/null
+++ b/transport/internet/tuic/protocol_test.go
@@ -0,0 +1,171 @@
+package tuic
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+func dest(t *testing.T, s string) net.Destination {
+	t.Helper()
+	d, err := net.ParseDestination(s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return d
+}
+
+func TestAddressRoundTrip(t *testing.T) {
+	for _, in := range []string{
+		"udp:1.2.3.4:53",
+		"udp:[2001:db8::1]:443",
+		"udp:example.com:8443",
+	} {
+		want := dest(t, in)
+		b, err := AppendAddress(nil, want)
+		if err != nil {
+			t.Fatalf("%s: %v", in, err)
+		}
+		got, err := ReadAddress(bytes.NewReader(b))
+		if err != nil || got == nil {
+			t.Fatalf("%s: read: %v %v", in, got, err)
+		}
+		if got.Address.String() != want.Address.String() || got.Port != want.Port {
+			t.Errorf("%s: got %v want %v", in, got, want)
+		}
+	}
+}
+
+func TestAddressWireFormat(t *testing.T) {
+	b, err := AppendAddress(nil, dest(t, "tcp:1.2.3.4:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []byte{AddrTypeIPv4, 1, 2, 3, 4, 0x01, 0xbb}; !bytes.Equal(b, want) {
+		t.Errorf("ipv4: got % x want % x", b, want)
+	}
+
+	b, err = AppendAddress(nil, dest(t, "tcp:a.io:80"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []byte{AddrTypeDomain, 4, 'a', '.', 'i', 'o', 0x00, 0x50}; !bytes.Equal(b, want) {
+		t.Errorf("domain: got % x want % x", b, want)
+	}
+}
+
+func TestNoneAddressHasNoPort(t *testing.T) {
+	d, err := ReadAddress(bytes.NewReader([]byte{AddrTypeNone, 0xaa}))
+	if err != nil || d != nil {
+		t.Fatalf("got %v %v", d, err)
+	}
+}
+
+func TestConnectAndAuthenticateWireFormat(t *testing.T) {
+	b, err := AppendConnectHeader(nil, dest(t, "tcp:1.2.3.4:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []byte{0x05, 0x01, AddrTypeIPv4, 1, 2, 3, 4, 0x01, 0xbb}; !bytes.Equal(b, want) {
+		t.Errorf("connect: got % x want % x", b, want)
+	}
+
+	var id [16]byte
+	for i := range id {
+		id[i] = byte(i)
+	}
+	token := bytes.Repeat([]byte{0xee}, tokenLength)
+	a := AppendAuthenticate(nil, id, token)
+	if len(a) != 2+16+tokenLength || a[0] != 0x05 || a[1] != 0x00 || !bytes.Equal(a[2:18], id[:]) || !bytes.Equal(a[18:], token) {
+		t.Errorf("authenticate: % x", a)
+	}
+
+	if got, want := AppendDissociate(nil, 0x0102), []byte{0x05, 0x03, 0x01, 0x02}; !bytes.Equal(got, want) {
+		t.Errorf("dissociate: got % x want % x", got, want)
+	}
+}
