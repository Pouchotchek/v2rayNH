+func TestPacketHeaderLengthConstant(t *testing.T) {
+	// A Packet without an address still carries the 1-byte "none" type.
+	h := packetHeader{FragTotal: 1}
+	b, err := h.append(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(b) != packetHeaderLength+1 {
+		t.Errorf("header is %d bytes, constant says %d+1", len(b), packetHeaderLength)
+	}
+}
