+func TestPacketHeaderRoundTrip(t *testing.T) {
+	d := dest(t, "udp:example.com:53")
+	in := packetHeader{AssocID: 7, PktID: 9, FragTotal: 1, FragID: 0, Size: 3, Addr: &d}
+	b, err := in.append(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	r := bytes.NewReader(b)
+	cmd, err := readCommandHeader(r)
+	if err != nil || cmd != CmdPacket {
+		t.Fatalf("cmd %v %v", cmd, err)
+	}
+	out, err := readPacketHeader(r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out.AssocID != 7 || out.PktID != 9 || out.FragTotal != 1 || out.FragID != 0 || out.Size != 3 || out.Addr == nil || out.Addr.Port != 53 {
+		t.Errorf("got %+v", out)
+	}
+	if r.Len() != 0 {
+		t.Errorf("%d trailing bytes", r.Len())
+	}
+}
