+package tuic
+
+import (
+	"context"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+const protocolName = "tuic"
+
+// TUIC protocol version 0x05, see https://github.com/tuic-protocol/tuic/blob/master/SPEC.md
+const (
+	Version byte = 0x05
+
+	CmdAuthenticate byte = 0x00
+	CmdConnect      byte = 0x01
+	CmdPacket       byte = 0x02
+	CmdDissociate   byte = 0x03
+	CmdHeartbeat    byte = 0x04
+)
+
+const (
+	AddrTypeDomain byte = 0x00
+	AddrTypeIPv4   byte = 0x01
+	AddrTypeIPv6   byte = 0x02
+	AddrTypeNone   byte = 0xff
+)
+
+const (
+	closeErrCodeOK = 0x0
+
+	// tokenLength is the size of the TOKEN field of the Authenticate command.
+	tokenLength = 32
+
+	// packetHeaderLength is the fixed part of a Packet command:
+	// VER, TYPE, ASSOC_ID(2), PKT_ID(2), FRAG_TOTAL, FRAG_ID, SIZE(2).
+	packetHeaderLength = 10
+
+	udpMessageChanSize  = 1024
+	idleCleanupInterval = 1 * time.Second
+	keepAlivePeriod     = 10 * time.Second
+	maxIdleTimeout      = 30 * time.Second
+	openStreamTimeout   = 10 * time.Second
+)
+
+const (
+	CongestionCubic   = "cubic"
+	CongestionNewReno = "new_reno"
+	CongestionBBR     = "bbr"
+
+	UDPRelayNative = "native"
+	UDPRelayQUIC   = "quic"
+)
+
+type datagramKey struct{}
+
+// ContextWithDatagram marks the dial as a UDP association (true) or a TCP connect (false).
+func ContextWithDatagram(ctx context.Context, v bool) context.Context {
+	return context.WithValue(ctx, datagramKey{}, v)
+}
+
+func DatagramFromContext(ctx context.Context) bool {
+	v, _ := ctx.Value(datagramKey{}).(bool)
+	return v
+}
+
+type status int
+
+const (
+	StatusNull status = iota
+	StatusActive
+	StatusInactive
+)
+
+func init() {
+	common.Must(internet.RegisterProtocolConfigCreator(protocolName, func() interface{} {
+		return &Config{}
+	}))
+}
